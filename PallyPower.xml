	<Button name="PPResizeGripTemplate" virtual="true">
		<Size>
			<AbsDimension x="16" y="16" />
		</Size>
		<Scripts>
			<OnMouseDown>
				PallyPower_StartScaling(arg1)
			</OnMouseDown>
			<OnMouseUp>
				PallyPower_StopScaling(arg1)
			</OnMouseUp>
		</Scripts>
		<NormalTexture file="Interface\AddOns\PallyPowerVanilla\artwork\PallyPower-ResizeGrip" />
		<HighlightTexture file="Interface\AddOns\PallyPowerVanilla\artwork\PallyPower-ResizeGrip" alphaMode="ADD" />
	</Button>
	<Button name="PPAssignmentCellTemplate" virtual="true">
		<Size>
			<AbsDimension x="80" y="54" />
		</Size>
		<Layers>
			<Layer level="OVERLAY">
				<Texture name="$parentIcon" file="Interface\AddOns\PallyPowerVanilla\artwork\Icons\Spell_Holy_SealOfWisdom">
					<Size>
						<AbsDimension x="32" y="32" />
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset>
								<AbsDimension x="24" y="-20" />
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				PallyPowerGridButton_OnLoad(this);
				this:RegisterForClicks("LeftButtonUp", "RightButtonUp");
				--[[this:EnableMouseWheel(1)]]
			</OnLoad>
			<OnClick>
				PallyPowerGridButton_OnClick(this, arg1)
			</OnClick>
			<OnEnter>
				PallyPowerGridButton_OnEnter(this)
			</OnEnter>
			<OnLeave>
				PallyPowerGridButton_OnLeave(this)
			</OnLeave>
			<OnMouseWheel>
				PallyPowerGridButton_OnMouseWheel(this, arg1)
			</OnMouseWheel>
		</Scripts>
	</Button>

